{
  "manifest_version": 3,
  "name": "Browser Bro",
  "version": "1.0.0",

  "permissions": ["scripting", "storage", "activeTab", "debugger"],

  "host_permissions": ["http://localhost:11434/*", "http://127.0.0.1:11434/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "action": {
    "default_popup": "index.html"
  }
}
